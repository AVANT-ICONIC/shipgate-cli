{
  "name": "@shipgate/cli",
  "version": "0.1.3",
  "packageManager": "pnpm@10.17.0",
  "description": "A local-first verification gate for AI-built projects.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/AVANT-ICONIC/shipgate-cli.git"
  },
  "bugs": {
    "url": "https://github.com/AVANT-ICONIC/shipgate-cli/issues"
  },
  "homepage": "https://github.com/AVANT-ICONIC/shipgate-cli#readme",
  "type": "module",
  "bin": {
    "shipgate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples/ci",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean --sourcemap",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "verify:self": "pnpm build && node dist/cli.js doctor",
    "release:github": "node scripts/release-github.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axe-core": "^4.11.4",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@avant-iconic/cleanroom": "github:AVANT-ICONIC/cleanroom#3da8cf6c73bce533e4d1b08e97b7e3992da31927",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
